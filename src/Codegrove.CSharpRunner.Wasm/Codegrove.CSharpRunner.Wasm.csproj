<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The C# runner on .NET for WebAssembly, loaded by web/public/csharp-runner/worker.js in a Web Worker.
    Build it with `npm run build:csharp` in web/ (publishes into web/public/csharp-runner/_framework).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- No ICU data: learners' programs format numbers and dates the invariant way. Saves a few MB. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep real exception messages ("Index was outside the bounds of the array."), not resource keys. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- Stable file names, so the worker can import _framework/dotnet.js directly. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- Roslyn's translated messages aren't used (the runner shows English plus its own plain-language text). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The static host compresses on the fly; pre-compressed copies would only double the folder size. -->
    <CompressionEnabled>false</CompressionEnabled>
    <!--
      The runner loads learner assemblies and reads their __CgGuard type by reflection: that's the job, and
      everything those assemblies can reach is rooted below. The analyzer can't know that, so its warnings are off.
    -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!--
      The practice web server (Codegrove.WebShim) turns learner records into JSON and back. Their types only
      exist once the learner's code is compiled, so System.Text.Json needs reflection (off by default in
      trimmed apps). The runner's own messages still use the source-generated RunnerJson.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codegrove.CSharpRunner\Codegrove.CSharpRunner.csproj" />
  </ItemGroup>

  <!--
    Trimming removes framework code the runner itself never calls, but learner programs are compiled later,
    in the browser, and may call anything in the allow-listed assemblies (see Codegrove.CSharpRunner.csproj).
    So those assemblies are kept whole. Roslyn is kept whole too: it uses reflection internally.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="System.Private.CoreLib;System.Runtime;System.Console;System.Collections;System.Linq" />
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis;Microsoft.CodeAnalysis.CSharp;Codegrove.CSharpRunner" />
    <!-- Learner servers call into the practice web server, which serializes their types with System.Text.Json. -->
    <TrimmerRootAssembly Include="Codegrove.WebShim;System.Text.Json" />
    <!-- Learner code uses DataAnnotations attributes ([Required], [Range], [StringLength]…) the shim never names. -->
    <TrimmerRootAssembly Include="System.ComponentModel.Annotations" />
    <!--
      Entity Framework Core (Web API lesson 6) and the real DI container the shim now uses. EF builds its
      model and its internal services by reflection over learner types, so the trimmer can't see what's
      needed: keep EF, its Microsoft.Extensions dependencies and the LINQ expression assemblies whole.
      Found by running EF programs in the browser, not by analysis; if an EF upgrade fails in the browser
      only, a newly needed dependency is the first suspect.
    -->
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore;Microsoft.EntityFrameworkCore.Abstractions;Microsoft.EntityFrameworkCore.InMemory" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.DependencyInjection;Microsoft.Extensions.DependencyInjection.Abstractions;Microsoft.Extensions.Caching.Memory;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Abstractions;Microsoft.Extensions.Options;Microsoft.Extensions.Primitives" />
    <TrimmerRootAssembly Include="System.Linq.Expressions;System.Linq.Queryable;System.Collections.Concurrent;System.ComponentModel;System.ComponentModel.TypeConverter;System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

</Project>
