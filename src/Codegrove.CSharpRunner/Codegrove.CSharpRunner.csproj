<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles and runs learner C# with Roslyn. Plain net10.0 so the same code runs in two places:
      - the browser, inside Codegrove.CSharpRunner.Wasm (.NET on WebAssembly, in a Web Worker)
      - the content checks in tests/Codegrove.CSharpRunner.Tests (every published C# challenge:
        the solution passes, the starter fails)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codegrove.CSharpRunner.Tests" />
    <!-- Uses WebChecks' request building and matching to run lesson checks against real ASP.NET Core. -->
    <InternalsVisibleTo Include="Codegrove.WebApi.ParityTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 5.0.0 is the compiler that shipped with .NET 10 (C# 14), so lessons match what `dotnet new console` gives. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The practice web server learner code compiles against in the Web API course (see its .csproj). -->
    <ProjectReference Include="..\Codegrove.WebShim\Codegrove.WebShim.csproj" />
  </ItemGroup>

  <!--
    Learner code compiles against .NET's reference assemblies, embedded here so the browser needs no
    file system. Only this allow-list is offered: no System.Net.*, System.IO.FileSystem, reflection
    emit or JavaScript interop, so learner code can't even name those APIs (the worker also removes
    the network functions, see web/public/csharp-runner/worker.js). Add an assembly here when a
    lesson needs it (System.Text.RegularExpressions, say): both the list and the count below.

    The files are taken from the references the build itself resolved for net10.0, so this works with
    any SDK: with the .NET 10 SDK they come from its own packs folder, with a newer SDK (global.json
    allows rolling forward, and CI's machines have .NET 11) from the NuGet targeting pack.
  -->
  <Target Name="CgEmbedReferenceAssemblies" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <_CgReference Include="@(Reference)" Condition="'%(Reference.FrameworkReferenceName)' == 'Microsoft.NETCore.App' and ('%(Filename)' == 'System.Runtime' or '%(Filename)' == 'System.Console' or '%(Filename)' == 'System.Collections' or '%(Filename)' == 'System.Linq' or '%(Filename)' == 'System.ComponentModel.Annotations')" />
      <EmbeddedResource Include="@(_CgReference)" LogicalName="ref/%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="'@(_CgReference->Count())' != '5'" Text="Expected 5 .NET reference assemblies to embed for learner code, found @(_CgReference->Count()): @(_CgReference->'%(Filename)')." />
  </Target>

  <!--
    The practice web server (Codegrove.WebShim) is embedded the same way, so learner code can compile
    against it in the browser. Its own output is the reference: it has no private API worth hiding beyond
    what `internal` already hides.
  -->
  <Target Name="CgEmbedWebShim" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_CgShim Include="@(ReferencePath)" Condition="'%(Filename)' == 'Codegrove.WebShim'" />
      <EmbeddedResource Include="@(_CgShim)" LogicalName="ref/%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="'@(_CgShim->Count())' != '1'" Text="Expected to embed Codegrove.WebShim.dll for learner code, found @(_CgShim->Count())." />
  </Target>

</Project>
